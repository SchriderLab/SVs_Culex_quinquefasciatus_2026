# Rcode for making SnpEff Plots
# Check out: https://joemcgirr.github.io/files/code_tutorials/my_genome/SnpEFF.html

library(vroom)
library(gt)
library(dplyr)
library(tidyr)
library(ggplot2)
library(patchwork)

# Each SV is counted once per ontology label, even if multiple transcripts
# or annotation entries contain that label.

setwd("./13_UPSET_SNPEFF/")

# Wong, B. Points of view: Color blindness. Nat Methods (2011).
bla <- "#000000"
  blu <- "#0072b2"
    grb <- "#56b4e9"
      lir <- "#cc79a7"
        gre <- "#009e73"
          red <- "#d55e00"
            org <- "#e69f00"
              yel <- "#f0e442"
                gry <- "#BBBBBB"
                  
                annotated_vcf_table <- "myVariants.ann.txt"
                
                # Load annotated variants
                ann <- vroom(annotated_vcf_table, guess_max = 1000000)
                
                # SnpEff impact categories and ontology labels
                ontology_term <- c(
                  "chromosome_number_variation",
                  "exon_loss_variant",
                  "frameshift_variant",
                  "rare_amino_acid_variant",
                  "splice_acceptor_variant",
                  "splice_donor_variant",
                  "start_lost",
                  "stop_gained",
                  "stop_lost",
                  "transcript_ablation",
                  "3_prime_UTR_truncation&exon_loss",
                  "5_prime_UTR_truncation&exon_loss_variant",
                  "coding_sequence_variant-moderate",
                  "conservative_inframe_deletion",
                  "conservative_inframe_insertion",
                  "disruptive_inframe_deletion",
                  "disruptive_inframe_insertion",
                  "missense_variant",
                  "regulatory_region_ablation",
                  "splice_region_variant-moderate",
                  "TFBS_ablation",
                  "5_prime_UTR_premature_start_codon_gain_variant",
                  "initiator_codon_variant",
                  "splice_region_variant-low",
                  "start_retained",
                  "stop_retained_variant",
                  "synonymous_variant",
                  "3_prime_UTR_variant",
                  "5_prime_UTR_variant",
                  "coding_sequence_variant-modifier",
                  "conserved_intergenic_variant",
                  "conserved_intron_variant",
                  "downstream_gene_variant",
                  "exon_variant",
                  "feature_elongation",
                  "feature_truncation",
                  "gene_variant",
                  "intergenic_region",
                  "intragenic_variant",
                  "intron_variant",
                  "mature_miRNA_variant",
                  "miRNA",
                  "NMD_transcript_variant",
                  "non_coding_transcript_exon_variant",
                  "non_coding_transcript_variant",
                  "regulatory_region_amplification",
                  "regulatory_region_variant",
                  "TF_binding_site_variant",
                  "TFBS_amplification",
                  "transcript_amplification",
                  "transcript_variant",
                  "upstream_gene_variant"
                )
                
                impact <- c(
                  rep("HIGH", 10),
                  rep("MODERATE", 11),
                  rep("LOW", 6),
                  rep("MODIFIER", 25)
                )
                
                stopifnot(length(impact) == length(ontology_term))
                
                ann_types <- data.frame(
                  impact = impact,
                  ontology_term = ontology_term,
                  stringsAsFactors = FALSE
                )

                
                # COUNT ONTOLOGY LABELS THROUGHOUT THE ENTIRE ANN STRING
                
                count_ontology <- function(ann_string, target) {
                  
                  if (is.na(ann_string) || !nzchar(ann_string)) {
                    return(FALSE)
                  }
                  
                  # Split ANN into individual annotation entries
                  entries <- strsplit(ann_string, ",", fixed = TRUE)[[1]]
                  
                  any(vapply(entries, function(entry) {
                    
                    # Split each annotation entry into fields
                    fields <- strsplit(entry, "|", fixed = TRUE)[[1]]
                    
                    # Search every field, regardless of its position
                    any(vapply(fields, function(field) {
                      
                      # Split compound terms joined by "&"
                      terms <- strsplit(field, "&", fixed = TRUE)[[1]]
                      
                      # Exact ontology-label match
                      target %in% terms
                      
                    }, logical(1)))
                    
                  }, logical(1)))
                }
                
                # Count each SV once per ontology label
                n_variants <- vapply(
                  ann_types$ontology_term,
                  function(ot) {
                    sum(vapply(
                      ann$ANN,
                      count_ontology,
                      logical(1),
                      target = ot
                    ))
                  },
                  integer(1)
                )
                
                ann_types$n_variants <- n_variants
                
                # Sort from least common to most common
                ann_types <- arrange(ann_types, n_variants)
                
                # Preserve plotting order
                ann_types$ontology_term <- factor(
                  ann_types$ontology_term,
                  levels = ann_types$ontology_term
                )
                
                ann_types$impact <- factor(
                  ann_types$impact,
                  levels = c("HIGH", "MODERATE", "LOW", "MODIFIER")
                )
                
                # Log transform counts
                ann_types$log_n_variants <- ifelse(
                  ann_types$n_variants > 0,
                  log10(ann_types$n_variants),
                  NA_real_
                )
                
                # PLOT

                p1 <- ann_types |>
                  filter(n_variants > 0) |>
                  ggplot(aes(ontology_term, log_n_variants, fill = impact)) +
                  geom_col() +
                  coord_flip() +
                  theme_minimal() +
                  theme(
                    axis.title.x = element_text(size = 18),
                    axis.title.y = element_text(size = 18),
                    axis.title = element_text(size = 20),
                    axis.text = element_text(size = 18),
                    plot.title = element_text(size = 18),
                    panel.grid = element_blank()
                  ) +
                  ylab("\nlog(Number of Annotated Variants)") +
                  xlab("") +
                  ylim(0, 8) +
                  ggtitle("Number of Variants with each SnpEFF Annotation (log scale)") +
                  geom_text(
                    aes(label = n_variants),
                    position = position_stack(),
                    hjust = -0.5
                  ) +
                  scale_fill_manual(values = c(red, yel, blu, gre))
                
                print(p1)
                
                
# high impact variant plot

p2 <- ann_types |>
  filter(
    impact == "HIGH",
    n_variants > 0
  ) |>
  ggplot(aes(ontology_term, n_variants, fill = impact)) +
  geom_col() +
  coord_flip() +
  theme_minimal() +
  theme(axis.title.x=element_text(size=18),
        axis.title.y=element_text(size=18),
        axis.title=element_text(18),
        axis.text=element_text(size=18),
        panel.grid = element_blank(),
        plot.title=element_text(size=20))+
  ylab("\nNumber of Annotated Variants")+ xlab("")+ylim(0,900)+
  ggtitle("Number of Variants with High Impact SnpEFF Annotations")+
  geom_text(aes(label=n_variants), position=position_stack(), hjust=-0.5)+
  scale_fill_manual(values = c(red,yel,blu,gre))

print(p2)


